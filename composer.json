{
    "name": "bitenxt/studio",
    "description": "Order messaging between BiteNXT Pro customers and studio staff (attachments + replies per order)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Bitenxt\\Studio\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Bitenxt\\Studio\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S 127.0.0.1:8090 -t public public/index.php"
    },
    "config": { "sort-packages": true }
}
